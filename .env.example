# Copiá este archivo como .env y reemplazá los valores de ejemplo.

# Credenciales para POST /auth/login
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD="reemplazar_por_contrasena_de_la_api"
JWT_SECRET=reemplazar_por_secreto_aleatorio

# Configuración de la app web del proyecto de Firebase
FIREBASE_API_KEY=valor_de_apiKey
FIREBASE_AUTH_DOMAIN=valor_de_authDomain
FIREBASE_PROJECT_ID=valor_de_projectId
FIREBASE_APP_ID=valor_de_appId

# Usuario de Firebase Authentication que usa el backend
FIREBASE_EMAIL=backend@example.com
FIREBASE_PASSWORD="reemplazar_por_contrasena_de_firebase"
